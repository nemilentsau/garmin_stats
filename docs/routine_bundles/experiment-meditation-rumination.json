{
  "id": "meditation-argument-rumination-2026-06",
  "name": "Meditation Effect on Argument Rumination",
  "status": "draft",
  "hypothesis": "Open monitoring with precise noting reduces argument-loop stickiness and emotional charge more than focused attention or quiet sitting; focused attention improves drift detection and return ease.",
  "goal": "Determine which meditation practice best reduces adversarial mental dialogue and improves disengagement from imaginary arguments.",
  "design": {
    "type": "within_subject_alternating_intervention",
    "comparison_level": "session_and_next_day",
    "expected_lag_days": [0, 1],
    "min_sessions_per_arm": 6,
    "min_adherence_pct": 0.75,
    "control_condition": "quiet_sitting_control",
    "analysis_unit": "session_checkin_and_day_summary"
  },
  "linked_routine_ids": [
    "meditation-skill-routine-4w"
  ],
  "intervention_arms": [
    {
      "id": "focused_attention",
      "practice_template_ids": [
        "meditation-focused-attention-counting",
        "meditation-focused-attention-raw-anchor"
      ],
      "expected_effect": "Improves detection of drift and return to anchor."
    },
    {
      "id": "open_monitoring_noting",
      "practice_template_id": "meditation-open-monitoring-noting",
      "expected_effect": "Improves non-continuation of arguments and reduces thought stickiness."
    },
    {
      "id": "quiet_sitting_control",
      "practice_template_id": "control-quiet-sitting",
      "expected_effect": "Controls for sitting time and expectancy."
    }
  ],
  "outcome_metrics": [
    {
      "path": "checkin.argument_loop_stickiness",
      "direction": "lower_is_better",
      "min_effect_size": 0.5
    },
    {
      "path": "checkin.argument_loop_frequency",
      "direction": "lower_is_better",
      "min_effect_size": 0.3
    },
    {
      "path": "checkin.emotional_charge",
      "direction": "lower_is_better",
      "min_effect_size": 0.5
    },
    {
      "path": "checkin.disengagement_success",
      "direction": "higher_is_better",
      "min_effect_size": 0.5
    },
    {
      "path": "checkin.drift_detection_speed",
      "direction": "higher_is_better",
      "min_effect_size": 0.5
    }
  ],
  "process_metrics": [
    "session.duration_minutes",
    "session.practice_template_id",
    "session.arguing_label_count",
    "session.planning_label_count",
    "session.rehearsing_label_count",
    "session.return_ease"
  ],
  "confounder_watch": [
    "work.conflict_or_argument_trigger",
    "stress.avg",
    "sleep.quality",
    "training.run_type",
    "checkin.caffeine_timing",
    "checkin.social_media_or_news_exposure"
  ],
  "analysis_plan": {
    "primary_contrast": "open_monitoring_noting versus focused_attention on argument_loop_stickiness and disengagement_success.",
    "secondary_contrast": "focused_attention versus quiet_sitting_control on drift_detection_speed.",
    "responder_definition": "At least 0.5-point lower stickiness and 0.5-point higher disengagement success."
  },
  "decision_rules": [
    {
      "condition": "open_monitoring_reduces_stickiness_more_than_focused_attention",
      "decision": "Make open monitoring/noting the primary meditation practice."
    },
    {
      "condition": "focused_attention_improves_detection_but_not_stickiness",
      "decision": "Keep focused attention as support practice only."
    },
    {
      "condition": "neither_beats_quiet_sitting",
      "decision": "Add stronger cognitive-boundary tools: scheduled planning windows and argument parking lot."
    }
  ]
}
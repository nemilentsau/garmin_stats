  ],
  "estimators": [
    {
      "id": "est.hrv_baseline",
      "inputs": [
        "garmin.rmssd_overnight"
      ],
      "output_signal": "hrv.dev_swc"
    },
    {
      "id": "est.rhr_baseline",
      "inputs": [
        "garmin.rhr"
      ],
      "output_signal": "rhr.delta_7d"
    },
    {
      "id": "est.e1rm.squat_pattern",
      "inputs": [
        "cap.set_log.lower_a"
      ],
      "output_signal": "e1rm.squat_pattern"
    },
    {
      "id": "est.e1rm.hip_hinge",
      "inputs": [
        "cap.set_log.lower_b"
      ],
      "output_signal": "e1rm.hip_hinge"
    },
    {
      "id": "est.e1rm.calf_soleus",
      "inputs": [
        "cap.set_log.hsr_a",
        "cap.set_log.hsr_b"
      ],
      "output_signal": "e1rm.calf_soleus_hsr"
    },
    {
      "id": "est.pacehr",
      "inputs": [
        "cap.run.rpe",
        "garmin.hr_pace_stream",
        "env.dew_point"
      ],
      "output_signal": "pacehr.easy_hr_at_ref_pace"
    },
    {
      "id": "est.heat_correction",
      "inputs": [
        "garmin.hr_pace_stream",
        "env.dew_point"
      ],
      "output_signal": "model.heat_correction.fitted"
    },
    {
      "id": "est.lthr",
      "inputs": [
        "cap.lthr.final20_hr",
        "cap.lthr.conditions"
      ],
      "output_signal": "event.ev_lthr_test.completed"
    },
    {
      "id": "est.strap_validity",
      "inputs": [
        "garmin.hr_stream_meta"
      ],
      "output_signal": "strap.validity_pct"
    },
    {
      "id": "est.flat_weeks",
      "inputs": [
        "load.run.zone_minutes",
        "strap.validity_pct"
      ],
      "output_signal": "weeks.flat_valid_count"
    },
    {
      "id": "est.upper_tonnage",
      "inputs": [
        "cap.set_log.push_a",
        "cap.set_log.push_b",
        "cap.set_log.pull_a",
        "cap.set_log.pull_b"
      ],
      "output_signal": "tonnage.upper.7d"
    },
    {
      "id": "est.planned_vs_executed",
      "inputs": [
        "cap.set_log.push_a",
        "cap.set_log.push_b",
        "cap.set_log.pull_a",
        "cap.set_log.pull_b",
        "cap.set_log.lower_a",
        "cap.set_log.lower_b",
        "cap.set_log.hsr_a",
        "cap.set_log.hsr_b"
      ],
      "output_signal": "tonnage.planned_vs_executed.7d"
    },
    {
      "id": "est.physique",
      "inputs": [
        "tonnage.upper.7d",
        "bodyweight"
      ],
      "output_signal": "physique.proxy"
    },
    {
      "id": "est.checkin",
      "inputs": [
        "cap.checkin.soreness",
        "cap.checkin.flags",
        "cap.checkin.core_done"
      ],
      "output_signal": "adherence.daily_core"
    },
    {
      "id": "est.day_rollup",
      "inputs": [
        "compiled.schedule",
        "cap.set_log.*",
        "garmin.hr_pace_stream"
      ],
      "output_signal": "load.day.total"
    }
  ],
  "state_vector": [
    {
      "id": "S1",
      "description": "threshold pace at LTHR, heat-corrected",
      "signal": "pacehr.easy_hr_at_ref_pace",
      "estimator_id": "est.pacehr",
      "swc": {
        "method": "rolling_sd",
        "window_days": 28,
        "k": 0.5
      }
    },
    {
      "id": "S2",
      "description": "e1RM squat pattern",
      "signal": "e1rm.squat_pattern",
      "estimator_id": "est.e1rm.squat_pattern",
      "swc": {
        "method": "rolling_sd",
        "window_days": 28,
        "k": 0.5
      }
    },
    {
      "id": "S3",
      "description": "e1RM calf/soleus HSR",
      "signal": "e1rm.calf_soleus_hsr",
      "estimator_id": "est.e1rm.calf_soleus",
      "swc": {
        "method": "rolling_sd",
        "window_days": 28,
        "k": 0.5
      }
    },
    {
      "id": "S4",
      "description": "upper physique proxy: tonnage trend + bodyweight",
      "signal": "physique.proxy",
      "estimator_id": "est.physique",
      "swc": {
        "method": "rolling_sd",
        "window_days": 28,
        "k": 0.5
      }
    },
    {
      "id": "S5",
      "description": "e1RM hip hinge (posterior chain)",
      "signal": "e1rm.hip_hinge",
      "estimator_id": "est.e1rm.hip_hinge",
      "swc": {
        "method": "rolling_sd",
        "window_days": 28,
        "k": 0.5
      }
    }
  ],
  "objective": {
    "progress": [
      {
        "state": "S1",
        "weight": 0.45
      },
      {
        "state": "S2",
        "weight": 0.15
      },
      {
        "state": "S3",
        "weight": 0.15
      },
      {
        "state": "S4",
        "weight": 0.15
      },
      {
        "state": "S5",
        "weight": 0.1
      }
    ],
    "constraints": [
      {
        "signal": "hrv.dev_swc",
        "band": {
          "lo": -1.5
        },
        "on_violation": {
          "action": "select_conservative_variants",
          "scope": "next_day"
        }
      },
      {
        "signal": "rhr.delta_7d",
        "band": {
          "hi": 5
        },
        "on_violation": {
          "action": "select_conservative_variants",
          "scope": "next_day"
        }
      },
      {
        "signal": "sleep.score",
        "band": {
          "lo": 50
        },
        "on_violation": {
          "action": "select_conservative_variants",
          "scope": "next_day"
        }
      },
      {
        "signal": "tonnage.planned_vs_executed.7d",
        "band": {
          "hi": 1.25
        },
        "on_violation": {
          "action": "flag_review",
          "scope": "next_3_days"
        }
      }
    ]
  }
}
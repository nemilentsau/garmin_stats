{
  "$description": "API endpoint response shapes. These are the data contracts between backend and frontend. Backend uses Pydantic models (app/models.py) validated by FastAPI response_model.",
  "architecture": "parser.py (typed per-day models) → stats.py (aggregation/flattening) → main.py (API responses)",
  "endpoints": {
    "GET /api/daily-aggregates": {
      "function": "parse_all_days → compute_daily_aggregates",
      "response_model": "DailyAggregatesResponse",
      "description": "Per-day aggregate stats for all metrics. Used by dashboard and trend charts.",
      "response": {
        "days": ["2026-01-01", "2026-01-02", "..."],
        "daily": [
          {
            "date": "string (YYYY-MM-DD)",
            "heart_rate": {
              "avg": "number | null",
              "min": "number | null",
              "max": "number | null",
              "resting": "number | null"
            },
            "stress": {
              "avg": "number | null",
              "min": "number | null",
              "max": "number | null"
            },
            "spo2": {
              "avg": "number | null",
              "min": "number | null",
              "max": "number | null"
            },
            "respiration": {
              "avg": "number | null",
              "min": "number | null",
              "max": "number | null"
            },
            "hrv": {
              "weekly_avg": "number | null (ms)",
              "nightly_avg": "number | null (ms)",
              "status": "string | null ('low' | 'balanced' | 'high')"
            },
            "sleep": {
              "score": "number | null (0-100)",
              "deep_score": "number | null (0-100)",
              "rem_score": "number | null (0-100)"
            },
            "skin_temp": {
              "deviation": "number | null (Celsius)",
              "deviation_7_day": "number | null (Celsius)",
              "nightly_value": "number | null (Celsius)"
            }
          }
        ]
      }
    },
    "GET /api/wellness?date={YYYY-MM-DD}": {
      "function": "parse_wellness → flatten_wellness",
      "response_model": "WellnessResponse",
      "description": "Intraday wellness readings for a specific day. Used by subtab intraday charts.",
      "response": {
        "days": ["string"],
        "heart_rate": [{ "timestamp": "ISO string | null", "value": "number" }],
        "stress": [{ "timestamp": "ISO string", "value": "number (0-100)" }],
        "spo2": [{ "timestamp": "ISO string", "value": "number (%)", "confidence": "number", "mode": "string" }],
        "respiration": [{ "timestamp": "ISO string", "value": "number (br/min)" }],
        "activity": [{ "timestamp": "ISO string | null", "activity_type": "string", "intensity": "number | null", "steps": "number | null", "calories": "number | null", "distance": "number | null" }],
        "steps_summary": [{ "timestamp": "ISO string | null", "steps": "number", "distance": "number | null", "calories": "number | null" }],
        "resting_hr": [{ "timestamp": "ISO string", "resting_hr": "number | null", "current_day_resting_hr": "number | null" }]
      },
      "notes": [
        "heart_rate timestamps are mostly null due to timestamp_16 compression",
        "~1800 HR readings, ~1400 stress, ~1100 SpO2, ~1400 respiration per day"
      ]
    },
    "GET /api/sleep?date={YYYY-MM-DD}": {
      "function": "parse_sleep → flatten_sleep",
      "response_model": "SleepResponse",
      "description": "Sleep stages and quality scores",
      "response": {
        "days": ["string"],
        "sleep_levels": [{ "date": "string", "timestamp": "ISO string", "level": "string (awake|light|deep|rem)" }],
        "sleep_assessments": [{ "date": "string", "overall_score": "number | null", "deep_sleep_score": "number | null", "light_sleep_score": "number | null", "rem_sleep_score": "number | null", "awake_time_score": "number | null", "awakenings_count": "number | null", "average_stress": "number | null" }]
      }
    },
    "GET /api/hrv?date={YYYY-MM-DD}": {
      "function": "parse_hrv → flatten_hrv",
      "response_model": "HrvResponse",
      "description": "HRV raw values and summaries",
      "response": {
        "days": ["string"],
        "hrv_values": [{ "date": "string", "timestamp": "ISO string", "value": "number (ms)" }],
        "hrv_summaries": [{ "date": "string", "weekly_average": "number | null", "last_night_average": "number | null", "last_night_5_min_high": "number | null", "baseline_low_upper": "number | null", "baseline_balanced_lower": "number | null", "baseline_balanced_upper": "number | null", "status": "string" }]
      }
    },
    "GET /api/skin-temp?date={YYYY-MM-DD}": {
      "function": "parse_skin_temp → flatten_skin_temp",
      "response_model": "SkinTempResponse",
      "description": "Skin temperature overnight data",
      "response": {
        "days": ["string"],
        "skin_temp_overnight": [{ "date": "string", "timestamp": "ISO string", "local_timestamp": "number", "nightly_value": "number | null", "average_deviation": "number | null", "average_7_day_deviation": "number | null" }]
      }
    }
  }
}

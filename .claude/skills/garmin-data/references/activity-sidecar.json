{
  "$dictionary": "Garmin Connect activity sidecar JSON data dictionary (the .json stored next to each activity FIT in data/garmin_activities/YYYY-MM-DD/)",
  "format_version": 1,
  "verified_against": ["2026-07-10/105726_running_generic.json (activityId 23548921459)", "2026-07-05/110251_running_generic.json (strap run)"],
  "provenance": "Garmin Connect's activity-summary API response, written verbatim at download by garmin_sync's FilesystemActivityStore. Fields Connect computes that the FIT lacks (VO2max, GAP, TE messages, body battery delta) come only from here.",
  "unit_warnings": [
    "Sidecar stride length and vertical oscillation are in CENTIMETERS; the FIT stores MILLIMETERS for the same measurements",
    "Sidecar positions are DEGREES; FIT positions are SEMICIRCLES",
    "Sidecar cadence fields are FULL steps/min; FIT cadence is half-cadence needing the ×2 rule",
    "Sidecar elevationGain/Loss are floats; FIT total_ascent/descent are integer-truncated meters (the ±1 m explains Connect showing 459 ft where FIT-derived shows 456 ft)"
  ],
  "fields": {
    "activityId": {"type": "int64", "unit": "-", "maps_to": "session.id / activity_id (as str)", "notes": "dedup key at download; primary session id when present"},
    "activityName": {"type": "str", "unit": "-", "maps_to": "activity_name", "notes": "e.g. 'Jersey City Running'"},
    "activityType": {"type": "object {typeId, typeKey, parentTypeId, ...}", "unit": "-", "maps_to": "-", "notes": "typeKey 'running'"},
    "startTimeGMT": {"type": "str 'YYYY-MM-DD HH:MM:SS'", "unit": "UTC", "maps_to": "(UTC-offset derivation with startTimeLocal — primary offset source)"},
    "startTimeLocal": {"type": "str 'YYYY-MM-DD HH:MM:SS'", "unit": "local", "maps_to": "(offset derivation)"},
    "beginTimestamp": {"type": "int64", "unit": "epoch ms", "maps_to": "-"},
    "endTimeGMT": {"type": "str", "unit": "UTC", "maps_to": "-"},
    "timeZoneId": {"type": "int", "unit": "Garmin tz id", "maps_to": "-"},
    "distance": {"type": "float", "unit": "m", "maps_to": "- (FIT total_distance preferred)"},
    "duration": {"type": "float", "unit": "s", "maps_to": "- (FIT total_timer_time preferred)"},
    "elapsedDuration": {"type": "float", "unit": "s", "maps_to": "-"},
    "movingDuration": {"type": "float", "unit": "s", "maps_to": "moving_time_s", "notes": "sidecar-only; FIT has no moving time"},
    "averageSpeed": {"type": "float", "unit": "m/s", "maps_to": "-"},
    "maxSpeed": {"type": "float", "unit": "m/s", "maps_to": "-"},
    "avgGradeAdjustedSpeed": {"type": "float", "unit": "m/s", "maps_to": "grade_adjusted_avg_speed_mps", "notes": "sidecar-only (GAP)"},
    "averageHR / maxHR": {"type": "float", "unit": "bpm", "maps_to": "- (FIT preferred)"},
    "averageRunningCadenceInStepsPerMinute": {"type": "float", "unit": "spm (FULL cadence)", "maps_to": "-", "notes": "equals FIT (avg_running_cadence + avg_fractional_cadence) × 2 exactly — the ×2 rule's ground truth"},
    "maxRunningCadenceInStepsPerMinute / maxDoubleCadence": {"type": "float", "unit": "spm", "maps_to": "-"},
    "avgPower / maxPower / normPower": {"type": "float", "unit": "W", "maps_to": "- (FIT preferred; normPower == FIT normalized_power)"},
    "avgStrideLength": {"type": "float", "unit": "cm", "maps_to": "-", "notes": "FIT avg_step_length is the same value in mm"},
    "avgVerticalOscillation": {"type": "float", "unit": "cm", "maps_to": "-", "notes": "FIT stores mm"},
    "avgVerticalRatio": {"type": "float", "unit": "%", "maps_to": "-"},
    "avgGroundContactTime": {"type": "float", "unit": "ms", "maps_to": "-"},
    "avgGroundContactBalance": {"type": "float", "unit": "% left", "maps_to": "-", "notes": "STRAP-ONLY; equals FIT avg_stance_time_balance"},
    "avgRespirationRate / maxRespirationRate / minRespirationRate": {"type": "float", "unit": "brpm", "maps_to": "-", "notes": "STRAP-ONLY; equal FIT enhanced_*_respiration_rate"},
    "aerobicTrainingEffect / anaerobicTrainingEffect": {"type": "float", "unit": "Garmin TE 0-5", "maps_to": "- (FIT preferred)"},
    "aerobicTrainingEffectMessage": {"type": "str enum", "unit": "-", "maps_to": "aerobic_te_message", "notes": "e.g. 'IMPROVING_AEROBIC_BASE_8'; sidecar-only"},
    "anaerobicTrainingEffectMessage": {"type": "str enum", "unit": "-", "maps_to": "anaerobic_te_message"},
    "trainingEffectLabel": {"type": "str enum", "unit": "-", "maps_to": "training_effect_label", "notes": "e.g. 'AEROBIC_BASE'"},
    "activityTrainingLoad": {"type": "float", "unit": "Garmin load scalar", "maps_to": "- (FIT training_load_peak preferred, same value)"},
    "vO2MaxValue": {"type": "float", "unit": "ml/kg/min", "maps_to": "vo2max", "notes": "sidecar-only"},
    "calories": {"type": "float", "unit": "kcal total", "maps_to": "- (FIT total_calories preferred)"},
    "bmrCalories": {"type": "float", "unit": "kcal resting share", "maps_to": "-"},
    "waterEstimated": {"type": "float", "unit": "ml sweat loss", "maps_to": "-"},
    "differenceBodyBattery": {"type": "int", "unit": "body-battery points (negative = drain)", "maps_to": "body_battery_delta", "notes": "sidecar-only"},
    "elevationGain / elevationLoss": {"type": "float", "unit": "m", "maps_to": "-", "notes": "float source Connect displays; FIT integer-truncates — candidate to prefer at next parser change"},
    "minElevation / maxElevation / avgElevation": {"type": "float", "unit": "m", "maps_to": "-"},
    "maxVerticalSpeed": {"type": "float", "unit": "m/s", "maps_to": "-"},
    "moderateIntensityMinutes / vigorousIntensityMinutes": {"type": "int", "unit": "min", "maps_to": "moderate/vigorous_intensity_minutes", "notes": "sidecar-only"},
    "steps": {"type": "int", "unit": "steps", "maps_to": "steps", "notes": "sidecar-only (FIT total_strides is stride count ≈ steps/2... verify before reuse: 4539 strides vs 9078 steps observed = exactly ×2)"},
    "hrTimeInZone_1..5": {"type": "float", "unit": "s", "maps_to": "- (FIT time_in_zone_mesgs preferred, includes boundaries)"},
    "powerTimeInZone_1..5": {"type": "float", "unit": "s", "maps_to": "-"},
    "fastestSplit_1000 / _1609 / _5000 / _10000": {"type": "float", "unit": "s", "maps_to": "-", "notes": "fastest rolling splits; _10000 only present on runs ≥10 km"},
    "lapCount": {"type": "int", "unit": "-", "maps_to": "-"},
    "locationName": {"type": "str", "unit": "-", "maps_to": "location_name"},
    "startLatitude / startLongitude / endLatitude / endLongitude": {"type": "float", "unit": "degrees", "maps_to": "- (FIT semicircle positions preferred)"},
    "splitSummaries": {"type": "list[object]", "unit": "-", "maps_to": "-", "notes": "per split-type rollups: splitType RWD_RUN|RWD_WALK|RWD_STAND|INTERVAL_ACTIVE with duration/distance/speeds/noOfSplits — the source of Connect's Run/Walk/Idle stat times; FIT split_mesgs carry the per-span detail"},
    "hasSplits / hasPolyline / hasHeatMap / hasImages / hasVideo": {"type": "bool", "unit": "-", "maps_to": "-"},
    "deviceId": {"type": "int64", "unit": "-", "maps_to": "-"},
    "manufacturer": {"type": "str", "unit": "-", "maps_to": "-"},
    "ownerId / ownerDisplayName / ownerFullName / ownerProfileImageUrl*": {"type": "various", "unit": "-", "maps_to": "-", "notes": "account metadata; ignore"},
    "userRoles / privacy / eventType / summarizedDiveInfo / decoDive / qualifyingDive / atpActivity / purposeful / pr / favorite / manualActivity / autoCalcCalories / elevationCorrected / parent / userPro": {"type": "various", "unit": "-", "maps_to": "-", "notes": "platform/dive/social flags; irrelevant to running analytics"}
  }
}

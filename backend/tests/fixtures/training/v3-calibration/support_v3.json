{
  "id": "support.v3",
  "name": "Block 0 Support \u2014 Tendon HSR + Daily",
  "schema_version": "3.0",
  "owns": [
    "calf_achilles",
    "soleus",
    "tibialis_foot",
    "trunk_core",
    "adductor"
  ],
  "cards": [
    {
      "id": "sup.hsr_a",
      "bundle_id": "support.v3",
      "name": "Tendon HSR A \u2014 Calf",
      "contract": {
        "kind": "overload",
        "adaptation": "tendon_stiffness",
        "progression_driver": "load",
        "state_ref": "S3",
        "ramp": {
          "weeks": 1,
          "endpoint": {
            "sets": 3,
            "reps": [
              4,
              6
            ],
            "pct_e1rm": 0.85
          }
        }
      },
      "prescription": {
        "exercises": [
          {
            "exercise_id": "standing_calf_raise",
            "targets": [
              "calf_achilles"
            ],
            "sets": 3,
            "reps": [
              4,
              6
            ],
            "load": {
              "pct_e1rm": 0.85,
              "rpe": 8
            },
            "logging": "set_rep_load",
            "tempo": "3s eccentric, full ROM, pause at stretch"
          }
        ]
      },
      "capture": [
        {
          "id": "cap.set_log.hsr_a",
          "type": "set_rep_load[]",
          "contract": {
            "model_id": "est.e1rm.calf_soleus",
            "decision_informed": "tendon load progression; S3"
          }
        }
      ],
      "est_duration_min": 12,
      "display_notes": "Week 1 ramp: RPE 6-7 loads, same sets and reps. Endpoint from week 2 per contract."
    },
    {
      "id": "sup.hsr_b",
      "bundle_id": "support.v3",
      "name": "Tendon HSR B \u2014 Soleus + Tibialis",
      "contract": {
        "kind": "overload",
        "adaptation": "tendon_stiffness",
        "progression_driver": "load",
        "state_ref": "S3",
        "ramp": {
          "weeks": 1,
          "endpoint": {
            "sets": 3,
            "reps": [
              4,
              6
            ],
            "pct_e1rm": 0.85
          }
        }
      },
      "prescription": {
        "exercises": [
          {
            "exercise_id": "seated_soleus_raise",
            "targets": [
              "soleus"
            ],
            "sets": 3,
            "reps": [
              6,
              10
            ],
            "load": {
              "pct_e1rm": 0.8,
              "rpe": 8
            },
            "logging": "set_rep_load",
            "tempo": "3s eccentric"
          },
          {
            "exercise_id": "tibialis_raise",
            "targets": [
              "tibialis_foot"
            ],
            "sets": 2,
            "reps": [
              15,
              25
            ],
            "load": {
              "rpe": 8
            },
            "logging": "set_rep_load"
          }
        ]
      },
      "capture": [
        {
          "id": "cap.set_log.hsr_b",
          "type": "set_rep_load[]",
          "contract": {
            "model_id": "est.e1rm.calf_soleus",
            "decision_informed": "tendon load progression; S3"
          }
        }
      ],
      "est_duration_min": 14,
      "display_notes": "Week 1 ramp: RPE 6-7 loads. Endpoint from week 2 per contract."
    },
    {
      "id": "sup.daily",
      "bundle_id": "support.v3",
      "name": "Daily Check-in + Core/Mobility (habitual)",
      "contract": {
        "kind": "recovery",
        "load_ceiling": {
          "duration_min": 15,
          "rpe_max": 5
        }
      },
      "prescription": {
        "segments": [
          {
            "label": "morning check-in: soreness + tissue flags",
            "intensity": {
              "rpe": 1
            },
            "duration_min": 2
          },
          {
            "label": "habitual core + mobility, athlete's choice",
            "intensity": {
              "rpe": 4
            },
            "duration_min": 12
          }
        ]
      },
      "capture": [
        {
          "id": "cap.checkin.soreness",
          "type": "enum",
          "contract": {
            "model_id": "est.checkin",
            "decision_informed": "morning readiness inputs for all selection rules"
          },
          "scale": {
            "min": 0,
            "max": 3
          }
        },
        {
          "id": "cap.checkin.flags",
          "type": "bool",
          "contract": {
            "model_id": "est.checkin",
            "decision_informed": "tissue flag inputs for selection rules"
          }
        },
        {
          "id": "cap.checkin.core_done",
          "type": "bool",
          "contract": {
            "model_id": "est.checkin",
            "decision_informed": "ambient load; adherence"
          }
        }
      ],
      "est_duration_min": 14
    }
  ],

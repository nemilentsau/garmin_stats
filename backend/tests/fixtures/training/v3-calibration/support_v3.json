    {
      "day": 2,
      "slot": "midday",
      "card_id": "sup.hsr_a",
      "variants": [
        {
          "id": "full",
          "stimulus_fraction": 1.0
        },
        {
          "id": "reduced",
          "stimulus_fraction": 0.6
        },
        {
          "id": "skip",
          "stimulus_fraction": 0.0
        }
      ],
      "selection": {
        "clauses": [
          {
            "when": {
              "any": [
                {
                  "signal": "flag.tissue.calf_achilles",
                  "op": "==",
                  "value": true
                },
                {
                  "signal": "flag.tissue.soleus",
                  "op": "==",
                  "value": true
                },
                {
                  "signal": "hrv.dev_swc",
                  "op": "<",
                  "value": -1.5
                }
              ]
            },
            "select": "skip"
          },
          {
            "when": {
              "any": [
                {
                  "signal": "hrv.dev_swc",
                  "op": "<",
                  "value": -0.75
                },
                {
                  "signal": "soreness.calf_achilles",
                  "op": ">=",
                  "value": 2
                }
              ]
            },
            "select": "reduced"
          }
        ],
        "default": "full",
        "on_missing_signal": "select_conservative"
      }
    },
